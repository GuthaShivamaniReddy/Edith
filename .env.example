# EDITH does not read a .env file. This lists the environment variables it understands.
# Secrets (API keys, tokens) go in the OS keychain: `uv run edith secrets set anthropic_api_key`.

# Override where config/*.yaml is read from (default: ./config in the repo).
EDITH_CONFIG_DIR=

# Override where runtime data (logs, costs, later memory and audit) is written (default: ~/.edith).
EDITH_DATA_DIR=

# Log level for the JSON log file: DEBUG | INFO | WARNING | ERROR
EDITH_LOG_LEVEL=
