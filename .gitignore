# Secrets never live in files. These are here only as a last line of defence.
.env
.env.*
!.env.example
*.pem
*.key

# Local runtime data (memory, audit log, costs, logs) lives in ~/.edith by default,
# but guard against a misconfigured data_dir pointing inside the repo.
data/
*.jsonl
*.sqlite
*.db

